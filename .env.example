# Firebase Configuration
# Get these values from your Firebase Console -> Project Settings -> General

# Your web app's Firebase configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Firebase Security Rules (optional)
# These are configured in Firebase Console, not in environment variables
# Make sure to set up proper security rules for your storage bucket

# Example Storage Security Rules:
# rules_version = '2';
# service firebase.storage {
#   match /b/{bucket}/o {
#     match /users/{userId}/{allPaths=**} {
#       allow read, write: if request.auth != null && request.auth.uid == userId;
#     }
#     match /public/{allPaths=**} {
#       allow read: if true;
#       allow write: if request.auth != null;
#     }
#   }
# }

# Development Notes:
# 1. Copy this file to .env and fill in your actual Firebase values
# 2. Never commit the .env file to version control
# 3. The VITE_ prefix is required for Vite to expose variables to the frontend
# 4. Make sure your Firebase Storage bucket is created in the Firebase Console
# 5. Configure proper security rules in Firebase Console before production use

# Setup Instructions:
# 1. Go to https://console.firebase.google.com
# 2. Create a new project or select an existing one
# 3. Enable Storage for your project
# 4. Go to Project Settings -> General -> Your apps
# 5. Click "Web app" to get your configuration
# 6. Copy the values here (add VITE_ prefix)
# 7. Set up Storage security rules in Firebase Console
